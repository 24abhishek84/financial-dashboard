{
  "name": "financial-dashboard",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/frontend",
    "packages/server",
    "packages/common"
  ],
  "scripts": {
    "install-all": "npm install",
    "build-all": "npm run build -r",
    "codegen": "npm run codegen --workspace=@financial-dashboard/server",
    "kill-ports": "kill-port 3000 4000 --silent",
    "dev": "npm run kill-ports && concurrently \"npm run dev --workspace=@financial-dashboard/server\" \"npm run start --workspace=@financial-dashboard/frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "kill-port": "^2.0.1"
  }
}
